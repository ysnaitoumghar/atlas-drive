---
import { siteConfig, type Lang } from '../config/site.config';
import { useT, href, L } from '../i18n/ui';
import Icon from './Icon.astro';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---
<form id="search-form" method="get" action={href(lang, 'cars/')} class="card rounded-[1.25rem] p-3 grid gap-3 md:grid-cols-[1.3fr_1fr_1fr_auto] items-end">
  <div>
    <label class="label" for="s-pickup">{t.hero.pickup}</label>
    <div class="relative">
      <Icon name="pin" class="w-4 h-4 absolute top-1/2 -translate-y-1/2 start-3 text-faint pointer-events-none" />
      <select id="s-pickup" name="pickup" class="field ps-10">
        {siteConfig.locations.map((l) => <option value={l.id}>{L(l.name, lang)}</option>)}
      </select>
    </div>
  </div>
  <div>
    <label class="label" for="s-from">{t.hero.from}</label>
    <input id="s-from" name="from" type="date" class="field" required />
  </div>
  <div class="relative route">
    <label class="label" for="s-to">{t.hero.to}</label>
    <input id="s-to" name="to" type="date" class="field" required />
  </div>
  <button type="submit" class="btn btn-gold h-12 w-full md:w-auto">
    <Icon name="arrow" class="w-4 h-4 order-last rtl:rotate-180" />{t.hero.search}
  </button>
</form>

<script>
  const from = document.getElementById('s-from') as HTMLInputElement | null;
  const to = document.getElementById('s-to') as HTMLInputElement | null;
  if (from && to) {
    const iso = (d: Date) => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    const addDays = (s: string, n: number) => { const d = new Date(s + 'T00:00'); d.setDate(d.getDate() + n); return iso(d); };
    const today = iso(new Date());
    from.min = today;
    from.value = addDays(today, 1);
    to.min = addDays(from.value, 1);
    to.value = addDays(from.value, 4);
    from.addEventListener('change', () => {
      if (!from.value) return;
      to.min = addDays(from.value, 1);
      if (!to.value || to.value <= from.value) to.value = addDays(from.value, 3);
    });
  }
</script>
